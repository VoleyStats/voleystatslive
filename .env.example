# Credenciales de Firebase
VITE_API_KEY=YOUR_API_KEY_HERE
VITE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN_HERE
VITE_PROJECT_ID=YOUR_PROJECT_ID_HERE
VITE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET_HERE
VITE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID_HERE
VITE_APP_ID=YOUR_APP_ID_HERE
VITE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID_HERE

# Ficha de Google Play. Vacía = el botón de Android no se muestra (ver
# src/components/StoreButtons.vue). Rellenar el día que la app esté publicada.
VITE_PLAY_URL=

# Dominio público del sitio (sin barra final). Fuente única en runtime/build
# (src/composables/useSeo.ts, scripts/prerender-head.mjs); si no se define,
# cae a https://clipeostats.com. Los ficheros estáticos que no pueden leer
# esta env var (index.html, public/sitemap.xml, public/robots.txt,
# public/llms.txt) llevan el dominio a mano con un comentario que apunta aquí.
VITE_SITE_ORIGIN=https://clipeostats.com
