{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "img-src 'self' data: blob: https://nannsjtfivbszbrjhjij.supabase.co"
        }
      ]
    }
  ]
}
